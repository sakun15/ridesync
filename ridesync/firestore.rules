rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    function isTripMember(tripId) {
      return isSignedIn() &&
        request.auth.uid in
          get(/databases/$(database)/documents/trips/$(tripId)).data.memberIds;
    }

    // Only memberIds may change on a join or leave — this stops someone
    // renaming the trip or reassigning ownership while adding themselves.
    function onlyMemberIdsChanged() {
      return request.resource.data.diff(resource.data)
        .affectedKeys().hasOnly(['memberIds']);
    }

    // Exactly one UID added, and it is the caller's own.
    function isAddingSelf() {
      return request.resource.data.memberIds.size()
               == resource.data.memberIds.size() + 1
        && request.auth.uid in request.resource.data.memberIds
        && !(request.auth.uid in resource.data.memberIds)
        && resource.data.memberIds.toSet()
             .difference(request.resource.data.memberIds.toSet()).size() == 0;
    }

    // Exactly one UID removed, and it is the caller's own.
    function isRemovingSelf() {
      return request.resource.data.memberIds.size()
               == resource.data.memberIds.size() - 1
        && !(request.auth.uid in request.resource.data.memberIds)
        && request.auth.uid in resource.data.memberIds
        && request.resource.data.memberIds.toSet()
             .difference(resource.data.memberIds.toSet()).size() == 0;
    }

    match /users/{userId} {
      allow read: if isSignedIn();
      allow create, update: if isSignedIn()
                            && request.auth.uid == userId
                            && request.resource.data.uid == userId;
      allow delete: if false;

      match /emergency_contacts/{contactId} {
        allow read, write: if isSignedIn() && request.auth.uid == userId;
      }
    }

    // Public lookup so people can join. Contains no sensitive data — a trip ID
    // grants no access by itself.
    match /invite_codes/{code} {
      allow read: if isSignedIn();
      allow create: if isSignedIn()
                    && request.resource.data.ownerId == request.auth.uid;
      allow update: if false;
      allow delete: if isSignedIn()
                    && resource.data.ownerId == request.auth.uid;
    }

    match /trips/{tripId} {
      allow read: if isSignedIn()
                  && request.auth.uid in resource.data.memberIds;

      allow create: if isSignedIn()
                    && request.resource.data.ownerId == request.auth.uid
                    && request.resource.data.memberIds == [request.auth.uid];

      allow update: if isSignedIn() && (
        resource.data.ownerId == request.auth.uid
        || (onlyMemberIdsChanged() && (isAddingSelf() || isRemovingSelf()))
      );

      allow delete: if false;

      match /members/{memberId} {
        // Members see the list; you can always read your own record, which is
        // how the join flow checks whether you're already in.
        allow read: if isTripMember(tripId) || request.auth.uid == memberId;
        allow write: if isSignedIn() && request.auth.uid == memberId;
      }
    }
    }

    // Live location. The most sensitive data in the app.
    //
    // Document ID is "{tripId}_{uid}" so both the trip and the owner are
    // derivable from the ID itself — no read of the document needed to decide
    // whether you may read it.
    match /live_locations/{locationId} {
      allow read: if isSignedIn() && isTripMember(resource.data.tripId);

      // Three conditions, each closing a different hole: you can't claim to be
      // someone else, the document ID must match its contents, and you must
      // actually be in the trip.
      allow create, update: if isSignedIn()
                           && request.resource.data.uid == request.auth.uid
                           && locationId == request.resource.data.tripId
                                            + '_' + request.auth.uid
                           && isTripMember(request.resource.data.tripId);

      allow delete: if isSignedIn()
                    && resource.data.uid == request.auth.uid;
    }
    match /{document=**} {
      allow read, write: if false;
    }
  }